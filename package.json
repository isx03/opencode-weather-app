{
  "name": "02-weather",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun test --isolate tests/ && bun build --compile --outfile weather-cli src/index.ts",
    "dev": "bun run src/index.ts --watch",
    "test": "bun test --isolate tests/",
    "test:watch": "bun test --isolate --watch tests/",
    "test:coverage": "bun test --isolate --coverage tests/"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
